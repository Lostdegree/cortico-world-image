{
  "name": "cortico-world-image",
  "version": "0.8.0",
  "type": "module",
  "description": "Image Studio（图片工坊）—— 给 Coopanion 桌宠的 cortico World 扩展：用任意 OpenAI 兼容的图片接口画图/改图、落盘成作品库、把图贴进控制台「对话」页；也可以接本地 ComfyUI，按优先级链轮流试。 / A cortico World extension that draws through any OpenAI-compatible image API or a local ComfyUI, keeps pictures on disk and shows them in the console.",
  "license": "MIT",
  "author": "lostdegree",
  "homepage": "https://github.com/Lostdegree/cortico-world-image#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lostdegree/cortico-world-image.git"
  },
  "bugs": {
    "url": "https://github.com/Lostdegree/cortico-world-image/issues"
  },
  "keywords": [
    "cortico-world",
    "cortico",
    "coopanion",
    "image",
    "image-generation",
    "text-to-image",
    "openai-compatible",
    "gpt-image"
  ],
  "engines": {
    "node": ">=22"
  },
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "src",
    "dist",
    "tools",
    "describe.json",
    "ENV_PROMPT.md",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "selfcheck": "node tools/prepublish.mjs",
    "prepublishOnly": "node tools/prepublish.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "cortico": {
    "kind": "world",
    "api": 6,
    "displayName": "图片工坊",
    "webUiClient": "dist/webui.js",
    "describe": "describe.json"
  }
}
